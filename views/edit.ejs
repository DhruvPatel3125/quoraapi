<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Post</title>
    <link rel="stylesheet" type="text/css" href="/editst.css">
</head>
<body>
    <h2>Edit Your Post</h2>
    <p>Post ID: <%= post.id %></p>
    <p>Post Username: @<%= post.username %></p>
    <form method="post" action="/posts/<%= post.id %>?_method=PATCH">
        <label for="postContent">Edit your post:</label>
        <textarea id="postContent" rows="10" cols="35" name="content"><%= post.content %></textarea>
        <button type="submit">Submit</button>
    </form>
</body>
</html>
